[Unit]
Description=Discord Claude Code Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=youruser
WorkingDirectory=/path/to/discord-claude-bot
EnvironmentFile=/path/to/discord-claude-bot/.env
ExecStart=/path/to/discord-claude-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
