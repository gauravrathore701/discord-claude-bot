[Unit]
Description=Discord Claude Code Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=gaurav
WorkingDirectory=/home/gaurav/Projects/discord-claude-bot
EnvironmentFile=/home/gaurav/Projects/discord-claude-bot/.env
ExecStart=/home/gaurav/Projects/discord-claude-bot/venv/bin/python bot.py
RuntimeDirectory=discord-claude
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
