[Unit]
Description=Discord Claude Code Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gaurav
WorkingDirectory=/home/gaurav/Projects/discord-claude-bot
EnvironmentFile=/home/gaurav/Projects/discord-claude-bot/.env
ExecStart=/home/gaurav/Projects/discord-claude-bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
